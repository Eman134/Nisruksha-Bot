generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model companies {
  company_id   String   @default("")
  user_id      BigInt   @default(0)
  name         String   @default("Empresa 404")
  logo         String?
  type         Int      @default(0)
  openvacancie Boolean  @default(true)
  bglink       String?
  loc          Int?
  descr        String?
  curriculum   String[]
  workers      String[]
  bank         Float    @default(0)
  rend         Float[]
  taxa         Int      @default(25)
  score        Float    @default(0)
  funcmax      Int      @default(3)

  @@id([company_id, user_id])
}

model cooldowns {
  user_id           BigInt @id @default(0)
  daily             String @default("0;0")
  move              String @default("0;0")
  global            String @default("0;0")
  roullete          String @default("0;0")
  crate             String @default("0;0")
  hunt              String @default("0;0")
  usekey            String @default("0;0")
  seecompany        String @default("0;0")
  profile           String @default("0;0")
  map               String @default("0;0")
  antispam          String @default("0;0")
  daily2            String @default("0;0")
  transferir        String @default("0;0")
  receivetr         String @default("0;0")
  sellterrain       String @default("0;0")
  settaxa           String @default("0;0")
  banned            String @default("0;0")
  rep               String @default("0;0")
  votealertdelay    String @default("0;0")
  flip              String @default("0;0")
  breakstreak       String @default("0;0")
  landplot          String @default("0;0")
  venda             String @default("0;0")
  vendaitem         String @default("0;0")
  maq               String @default("0;0")
  setname           String @default("0;0")
  usaritem          String @default("0;0")
  alertdelay        String @default("0;0")
  molduras          String @default("0;0")
  luckycards        String @default("0;0")
  votetopgg         String @default("0;0")
  verprocessamentos String @default("0;0")
  mastery           String @default("0;0")
  mine              String @default("0;0")
  blackjack         String @default("0;0")
  patodourado       String @default("0;0")
}

model globals {
  user_id      BigInt   @id
  totalcmd     BigInt   @default(0)
  donates      BigInt   @default(0)
  totaldonates Float    @default(0)
  keys         Json[]   @db.Json
  status       Int      @default(0)
  man          String?
  remember     Json[]   @db.Json
  bets         Json?    @db.Json
  money        BigInt   @default(0)
  events       Json?    @db.Json
  processing   BigInt[]
}

model machines {
  user_id       BigInt @id
  machine       Float  @default(100)
  level         Float  @default(1)
  xp            Float  @default(0)
  energymax     Float  @default(30)
  energy        Float  @default(0)
  totalxp       Float  @default(0)
  durability    Float  @default(1500)
  pressure      Float  @default(0)
  refrigeration Float  @default(0)
  pollutants    Float  @default(0)
  slots         Json[] @db.Json
}

model players {
  user_id    BigInt   @id
  money      Float    @default(0)
  streak     Int      @default(0)
  perm       Int      @default(1)
  points     Float    @default(0)
  bio        String   @default("Nenhuma biografia foi definida, use <prefixo>bio <texto>")
  token      Float    @default(0)
  bglink     String?
  bank       Float    @default(0)
  saq        Float    @default(0)
  dep        Float    @default(0)
  tran       Float    @default(0)
  cmdsexec   Float    @default(0)
  stamina    BigInt   @default(0)
  company    String?
  banreason  String   @default("Não se importaram com você o suficiente para especificar um motivo.")
  mvp        Float?
  plots      Json?    @db.Json
  reps       BigInt   @default(0)
  rod        Json?    @db.Json
  companyact Json?    @db.Json
  frames     BigInt[]
  badges     BigInt[]
  mastery    BigInt   @default(0)
}

model players_utils {
  user_id       BigInt @id
  invite        Json?  @db.Json
  profile_color Int    @default(0)
  backpack      Float  @default(800)
  process       Json?  @db.Json
}

model servers {
  server_id BigInt @id
  lastcmd   Float  @default(0)
  cmdsexec  Float  @default(0)
  banreason String @default("Não se importaram com o servidor o suficiente para especificar um motivo.")
  status    Int    @default(0)
}

model site {
  user_id BigInt  @id
  first   Boolean @default(true)
  todo    Json[]  @db.Json
}

